# ==========================================================================
# GPA Academy — Landing Page — Variables de entorno
# Copia este archivo a ".env.local" y completa los valores reales.
# NUNCA subas ".env.local" al repositorio (ya está en .gitignore).
# ==========================================================================

# --- Geolocalización por IP (server-side, usado en app/api/geo) ----------
# Servicio sugerido: https://ipgeolocation.io/ o https://ipapi.co/
GEOLOCATION_API_URL=https://api.ipgeolocation.io/ipgeo
GEOLOCATION_API_KEY=REEMPLAZA_CON_TU_API_KEY_DE_GEOLOCALIZACION

# --- Tasas de cambio en tiempo real (server-side, usado en app/api/exchange-rate) ---
# Servicio sugerido: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_RATE_API_KEY=REEMPLAZA_CON_TU_API_KEY_DE_TASAS_DE_CAMBIO

# --- WhatsApp flotante -----------------------------------------------------
# Formato internacional sin "+" ni espacios, ej: 18095551234
NEXT_PUBLIC_WHATSAPP_NUMBER=18095551234

# --- Google Forms embebido (uno por programa) -------------------------------
NEXT_PUBLIC_GOOGLE_FORM_ID_ASISTENCIA_QUIRURGICA=REEMPLAZA_CON_ID_DE_GOOGLE_FORM
NEXT_PUBLIC_GOOGLE_FORM_ID_SUTURA=REEMPLAZA_CON_ID_DE_GOOGLE_FORM
NEXT_PUBLIC_GOOGLE_FORM_ID_NEUROIMAGENES=REEMPLAZA_CON_ID_DE_GOOGLE_FORM
NEXT_PUBLIC_GOOGLE_FORM_ID_LAPAROSCOPICA=REEMPLAZA_CON_ID_DE_GOOGLE_FORM

# --- Pagadito: URL/botón de pago (uno por programa) -------------------------
NEXT_PUBLIC_PAGADITO_URL_ASISTENCIA_QUIRURGICA=REEMPLAZA_CON_URL_DE_PAGADITO
NEXT_PUBLIC_PAGADITO_URL_SUTURA=REEMPLAZA_CON_URL_DE_PAGADITO
NEXT_PUBLIC_PAGADITO_URL_NEUROIMAGENES=REEMPLAZA_CON_URL_DE_PAGADITO
NEXT_PUBLIC_PAGADITO_URL_LAPAROSCOPICA=REEMPLAZA_CON_URL_DE_PAGADITO
