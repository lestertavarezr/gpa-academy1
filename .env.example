# Variables usadas SOLO por docker-compose (ver docker-compose.yml), para
# correr los 5 servicios dockerizados de forma persistente (pensado para un
# servidor/VPS que va a quedar prendido varios días).
#
# Si en cambio corrés cada servicio nativamente sin Docker (para desarrollo
# local, como en el resto de este README), usá los .env.example de cada
# carpeta (bot-engine/.env.example, backend/.env.example,
# frontend/.env.local.example) — no tienen relación con este archivo.

# Credenciales de Binance TESTNET (https://testnet.binance.vision/)
# NUNCA uses acá API keys de una cuenta real de Binance.
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Secretos: generar valores propios y distintos entre sí, ej. `openssl rand -base64 32`.
# docker-compose falla al arrancar si estos quedan vacíos (a propósito).
JWT_SECRET=
NEXTAUTH_SECRET=

# URL pública por la que el NAVEGADOR del usuario llega al backend/frontend.
# En un VPS esto NO puede ser "http://backend:3001" (ese nombre solo resuelve
# entre contenedores) — tiene que ser la IP o dominio público del servidor,
# ej. http://203.0.113.10:3001. Si cambiás esta URL después de la primera
# vez, hay que reconstruir la imagen del frontend (ver README), porque
# Next.js la inlinea en el bundle en build time.
PUBLIC_BACKEND_URL=http://localhost:3001
PUBLIC_FRONTEND_URL=http://localhost:3000

# Opcionales, tienen un default razonable si se omiten.
JWT_EXPIRES_IN=2h
SIGNAL_CACHE_TTL_SECONDS=180
PAPER_BOT_TICK_SECONDS=60
