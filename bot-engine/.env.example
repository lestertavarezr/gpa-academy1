# Credenciales de Binance TESTNET (https://testnet.binance.vision/)
# NUNCA uses aqui API keys de una cuenta real de Binance.
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Los simbolos soportados (BTC/USDT, ETH/USDT, SOL/USDT) estan definidos
# en app/symbols.py, no requieren variable de entorno.

# Postgres: el bot-engine persiste aqui el estado de los bots de paper trading
# (paper_bots, paper_trades, paper_bot_events, paper_bot_equity_snapshots)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradinghub

# Redis: broker de Celery para el scheduler de paper trading. Usa un indice
# de DB distinto (/1) al que usa el backend para cache de señales (/0), para
# no mezclar las dos colas de datos en la misma instancia de Redis.
CELERY_BROKER_URL=redis://localhost:6379/1

# Cada cuantos segundos Celery Beat revisa que bots estan "vencidos" para evaluar
PAPER_BOT_TICK_SECONDS=60
