{
  "name": "gpa-academy-animated",
  "version": "1.0.0",
  "private": true,
  "description": "GPA Academy – animaciones cinematográficas sincronizadas con la narración (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts GPAAcademy out/gpa-academy-animated.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts GPAAcademy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@react-three/fiber": "^8.18.0",
    "@remotion/cli": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "@remotion/motion-blur": "^4.0.541",
    "@remotion/three": "^4.0.541",
    "@remotion/transitions": "^4.0.541",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.541",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2"
  }
}
