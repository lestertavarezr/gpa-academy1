# URL del backend NestJS
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# NextAuth: secreto para firmar/cifrar la sesion (independiente del JWT_SECRET
# del backend). Generar uno propio, ej. `openssl rand -base64 32`.
NEXTAUTH_SECRET=change-me-to-a-long-random-value
NEXTAUTH_URL=http://localhost:3000
