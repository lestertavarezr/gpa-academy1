# URL del servicio bot-engine (FastAPI)
BOT_ENGINE_URL=http://localhost:8000

# Puerto en el que corre este servicio NestJS
PORT=3001

# Redis: cache de señales generadas (evita recalcular en cada request)
REDIS_URL=redis://localhost:6379

# Segundos que se cachea una señal antes de recalcularla (1-5 min recomendado)
SIGNAL_CACHE_TTL_SECONDS=180

# Postgres: histórico de señales para medir precisión a futuro
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tradinghub

# JWT propio de este backend (independiente del secreto de NextAuth en el
# frontend). Cambiar por un valor largo y aleatorio antes de producción.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=2h
