{
  "name": "neuroscan",
  "version": "2.0.0",
  "private": true,
  "description": "NEURO//SCAN — entrenamiento en lectura sistemática de neuroimágenes (GPA Academy)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "validate": "node scripts/validate-content.mjs",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run validate && npm test && npm run build",
    "content:export-csv": "node scripts/content-csv.mjs export",
    "content:import-csv": "node scripts/content-csv.mjs import",
    "vapid:generate": "node scripts/generate-vapid.mjs",
    "db:migrate:local": "wrangler d1 migrations apply neuroscan --local",
    "db:migrate:remote": "wrangler d1 migrations apply neuroscan --remote",
    "deploy": "npm run check && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.1",
    "esbuild": "^0.28.2",
    "http_ece": "^1.2.1",
    "jsdom": "^30.1.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
